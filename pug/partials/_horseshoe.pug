//- A horseshoe in spectral order: violet at the left heel, up the leg, over a green arch, down to red at the right heel, with the line of purples across the gap between the heels. It's the idea of the CIE 1931 chromaticity diagram tidied into an actual horseshoe, so on stage it's "the spectrum, bent into a horseshoe", not the CIE diagram. scss/talk/_horseshoe.scss places it.
-
  // The centre line, in viewBox units: a semicircular arch, with legs that taper a little inward to the heels.
  const shoe = { cx: 500, cy: 420, r: 300, taper: 40, heelY: 770, thickness: 100, bands: 240 }
  const shoeHeelL = [shoe.cx - shoe.r + shoe.taper, shoe.heelY]
  const shoeHeelR = [shoe.cx + shoe.r - shoe.taper, shoe.heelY]
  const shoeLeg = Math.hypot(shoe.taper, shoe.heelY - shoe.cy)
  const shoeArch = Math.PI * shoe.r
  const shoeLength = 2 * shoeLeg + shoeArch

  // The point a distance s along the centre line, from the left heel.
  const shoeAt = (s) => {
    if (s <= shoeLeg) {
      const f = s / shoeLeg
      return [shoeHeelL[0] - shoe.taper * f, shoe.heelY - (shoe.heelY - shoe.cy) * f]
    }
    if (s <= shoeLeg + shoeArch) {
      const phi = (s - shoeLeg) / shoe.r
      return [shoe.cx - shoe.r * Math.cos(phi), shoe.cy - shoe.r * Math.sin(phi)]
    }
    const f = (s - shoeLeg - shoeArch) / shoeLeg
    return [shoe.cx + shoe.r - shoe.taper * f, shoe.cy + (shoe.heelY - shoe.cy) * f]
  }

  // The iron's outer and inner edges, offset from the centre line along its normal.
  const shoeCentre = Array.from({ length: shoe.bands + 1 }, (_, i) => shoeAt(shoeLength * i / shoe.bands))
  const shoeEdge = (i, side) => {
    const [ax, ay] = shoeCentre[Math.max(i - 1, 0)]
    const [bx, by] = shoeCentre[Math.min(i + 1, shoe.bands)]
    const run = Math.hypot(bx - ax, by - ay)
    const half = side * shoe.thickness / 2
    const [x, y] = shoeCentre[i]
    return `${(x + (by - ay) / run * half).toFixed(1)},${(y - (bx - ax) / run * half).toFixed(1)}`
  }
  const shoeBand = (i) => [shoeEdge(i, 1), shoeEdge(i + 1, 1), shoeEdge(i + 1, -1), shoeEdge(i, -1)].join(" ")
  const shoeNm = (i) => 380 + 320 * (i + 0.5) / shoe.bands
  const shoeBands = Array.from({ length: shoe.bands }, (_, i) => i)

  // An approximation of a wavelength's colour on an sRGB screen, after Dan Bruton's. Violet keeps only a little red, so it doesn't read as purple, and the far violet end only dims to 70%, so it still shows on a projector.
  const spectralColour = (nm) => {
    let r = 0, g = 0, b = 0
    if (nm < 440) { r = 0.6 * (440 - nm) / 60; b = 1 }
    else if (nm < 490) { g = (nm - 440) / 50; b = 1 }
    else if (nm < 510) { g = 1; b = (510 - nm) / 20 }
    else if (nm < 580) { r = (nm - 510) / 70; g = 1 }
    else if (nm < 645) { r = 1; g = (645 - nm) / 65 }
    else { r = 1 }
    const edge = nm < 420 ? 0.7 + 0.3 * (nm - 380) / 40 : 1
    const channel = (v) => Math.round(255 * Math.pow(v * edge, 0.8))
    return `rgb(${channel(r)}, ${channel(g)}, ${channel(b)})`
  }

mixin horseshoe()
  svg.shoe(viewBox="100 50 800 860" role="img")&attributes(attributes)
    title Every visible wavelength in order, from violet at 380 nanometres to red at 700, bent into a horseshoe and closed by the line of purples
    defs
      linearGradient#LineOfPurples(gradientUnits="userSpaceOnUse" x1=shoeHeelL[0] y1=shoeHeelL[1] x2=shoeHeelR[0] y2=shoeHeelR[1])
        stop(offset="0" stop-color=spectralColour(380))
        stop(offset="1" stop-color=spectralColour(700))
    //- Round heels, then the iron as thin bands, each in its own wavelength's colour. A hairline stroke in the band's own colour hides the seams between bands.
    circle(cx=shoeHeelL[0] cy=shoeHeelL[1] r=shoe.thickness / 2 fill=spectralColour(380))
    circle(cx=shoeHeelR[0] cy=shoeHeelR[1] r=shoe.thickness / 2 fill=spectralColour(700))
    g.spectrum(stroke-width="1.5" stroke-linejoin="round")
      each i in shoeBands
        polygon(points=shoeBand(i) fill=spectralColour(shoeNm(i)) stroke=spectralColour(shoeNm(i)))
    g.labels(font-size="42")
      //- Beside the heels, level with their centres, so the line of purples has the space under it to itself.
      text(x=shoeHeelL[0] - 65 y=shoe.heelY + 15 text-anchor="end") 380
      text(x=shoeHeelR[0] + 65 y=shoe.heelY + 15) 700
    //- Half the iron's weight, so the shoe stays a horseshoe and the line reads as something added to it.
    g.purples.fragment.fade-in(data-fragment-index="1")
      line(x1=shoeHeelL[0] y1=shoeHeelL[1] x2=shoeHeelR[0] y2=shoeHeelR[1] stroke="url(#LineOfPurples)" stroke-width=shoe.thickness / 2 stroke-linecap="round")
      text.name(x=shoe.cx y=shoe.heelY + 100 font-size="42" text-anchor="middle") the line of purples
