//- The CIE 1931 2° spectral locus: where every visible wavelength lands on the chromaticity diagram, from the standard table at 5 nm steps. Each segment is stroked in an approximation of its own wavelength's colour, and the line of purples, the straight edge between 380 and 700 nm, closes the gap. Coordinates are the diagram's x and y times 1000, with y flipped for SVG. scss/talk/_horseshoe.scss places it.
-
  const cieLocus = [
    [380, 0.1741, 0.0050], [385, 0.1740, 0.0050], [390, 0.1738, 0.0049], [395, 0.1736, 0.0049],
    [400, 0.1733, 0.0048], [405, 0.1730, 0.0048], [410, 0.1726, 0.0048], [415, 0.1721, 0.0048],
    [420, 0.1714, 0.0051], [425, 0.1703, 0.0058], [430, 0.1689, 0.0069], [435, 0.1669, 0.0086],
    [440, 0.1644, 0.0109], [445, 0.1611, 0.0138], [450, 0.1566, 0.0177], [455, 0.1510, 0.0227],
    [460, 0.1440, 0.0297], [465, 0.1355, 0.0399], [470, 0.1241, 0.0578], [475, 0.1096, 0.0868],
    [480, 0.0913, 0.1327], [485, 0.0687, 0.2007], [490, 0.0454, 0.2950], [495, 0.0235, 0.4127],
    [500, 0.0082, 0.5384], [505, 0.0039, 0.6548], [510, 0.0139, 0.7502], [515, 0.0389, 0.8120],
    [520, 0.0743, 0.8338], [525, 0.1142, 0.8262], [530, 0.1547, 0.8059], [535, 0.1929, 0.7816],
    [540, 0.2296, 0.7543], [545, 0.2658, 0.7243], [550, 0.3016, 0.6923], [555, 0.3373, 0.6589],
    [560, 0.3731, 0.6245], [565, 0.4087, 0.5896], [570, 0.4441, 0.5547], [575, 0.4788, 0.5202],
    [580, 0.5125, 0.4866], [585, 0.5448, 0.4544], [590, 0.5752, 0.4242], [595, 0.6029, 0.3965],
    [600, 0.6270, 0.3725], [605, 0.6482, 0.3514], [610, 0.6658, 0.3340], [615, 0.6801, 0.3197],
    [620, 0.6915, 0.3083], [625, 0.7006, 0.2993], [630, 0.7079, 0.2920], [635, 0.7140, 0.2859],
    [640, 0.7190, 0.2809], [645, 0.7230, 0.2770], [650, 0.7260, 0.2740], [655, 0.7283, 0.2717],
    [660, 0.7300, 0.2700], [665, 0.7311, 0.2689], [670, 0.7320, 0.2680], [675, 0.7327, 0.2673],
    [680, 0.7334, 0.2666], [685, 0.7340, 0.2660], [690, 0.7344, 0.2656], [695, 0.7346, 0.2654],
    [700, 0.7347, 0.2653],
  ]
  const cieX = (x) => +(1000 * x).toFixed(1)
  const cieY = (y) => +(900 - 1000 * y).toFixed(1)

  // An approximation of a wavelength's colour on an sRGB screen, after Dan Bruton's. Violet keeps only a little red, so it doesn't read as purple, and the far violet end only dims to 70%, so it still shows on a projector.
  const spectralColour = (nm) => {
    let r = 0, g = 0, b = 0
    if (nm < 440) { r = 0.6 * (440 - nm) / 60; b = 1 }
    else if (nm < 490) { g = (nm - 440) / 50; b = 1 }
    else if (nm < 510) { g = 1; b = (510 - nm) / 20 }
    else if (nm < 580) { r = (nm - 510) / 70; g = 1 }
    else if (nm < 645) { r = 1; g = (645 - nm) / 65 }
    else { r = 1 }
    const edge = nm < 420 ? 0.7 + 0.3 * (nm - 380) / 40 : 1
    const channel = (v) => Math.round(255 * Math.pow(v * edge, 0.8))
    return `rgb(${channel(r)}, ${channel(g)}, ${channel(b)})`
  }

  const cieViolet = cieLocus[0]
  const cieRed = cieLocus[cieLocus.length - 1]

mixin horseshoe()
  svg.cie(viewBox="-90 -20 940 1000" role="img")&attributes(attributes)
    title Every visible wavelength on the CIE 1931 chromaticity diagram, a horseshoe from 380 to 700 nanometres, closed by the line of purples
    defs
      linearGradient#LineOfPurples(gradientUnits="userSpaceOnUse" x1=cieX(cieViolet[1]) y1=cieY(cieViolet[2]) x2=cieX(cieRed[1]) y2=cieY(cieRed[2]))
        stop(offset="0" stop-color=spectralColour(cieViolet[0]))
        stop(offset="1" stop-color=spectralColour(cieRed[0]))
    g.locus(stroke-width="14" stroke-linecap="round")
      each point, i in cieLocus.slice(1)
        - const previous = cieLocus[i]
        line(x1=cieX(previous[1]) y1=cieY(previous[2]) x2=cieX(point[1]) y2=cieY(point[2]) stroke=spectralColour((previous[0] + point[0]) / 2))
    g.labels(font-size="42")
      text(x="174" y="962" text-anchor="middle") 380 nm
      text(x="74" y="32" text-anchor="middle") 520
      text(x="765" y="648") 700
    g.purples.fragment.fade-in(data-fragment-index="1")
      line(x1=cieX(cieViolet[1]) y1=cieY(cieViolet[2]) x2=cieX(cieRed[1]) y2=cieY(cieRed[2]) stroke="url(#LineOfPurples)" stroke-width="14" stroke-linecap="round")
      //- Set under the line, along it: 24.9° is the line's own slope.
      text.name(x="454" y="822" font-size="42" text-anchor="middle" transform="rotate(-24.9 454 765)") the line of purples
