//- The talk's spectrum drawings, all coloured by spectralColour below: the purple beat (the spectrum as a line that bends into a horseshoe and gets closed with purple) and Webb's infrared translated into it. Included once, from _talk-mixins.pug.

-
  // An approximation of a wavelength's colour on an sRGB screen, after Dan Bruton's. Violet keeps only a little red, so it doesn't read as purple, and the far violet end only dims to 70%, so it still shows on a projector.
  const spectralColour = (nm) => {
    let r = 0, g = 0, b = 0
    if (nm < 440) { r = 0.6 * (440 - nm) / 60; b = 1 }
    else if (nm < 490) { g = (nm - 440) / 50; b = 1 }
    else if (nm < 510) { g = 1; b = (510 - nm) / 20 }
    else if (nm < 580) { r = (nm - 510) / 70; g = 1 }
    else if (nm < 645) { r = 1; g = (645 - nm) / 65 }
    else { r = 1 }
    const edge = nm < 420 ? 0.7 + 0.3 * (nm - 380) / 40 : 1
    const channel = (v) => Math.round(255 * Math.pow(v * edge, 0.8))
    return `rgb(${channel(r)}, ${channel(g)}, ${channel(b)})`
  }
  const lineStops = Array.from({ length: 33 }, (_, i) => 380 + i * 10)

  // The purple beat draws on the whole canvas, in canvas px (viewBox 0 0 1280 720). The horseshoe's centre line is a semicircular arch with legs that taper a little inward to the heels, laid out in its own units and then scaled into the right half of the canvas.
  const shoe = { cx: 500, cy: 420, r: 300, taper: 40, heelY: 770, thickness: 100, bands: 240 }
  const shoeScale = 0.806
  const onCanvas = ([x, y]) => [620 + (x - 150) * shoeScale, 30 + (y - 70) * shoeScale]
  const shoeLeg = Math.hypot(shoe.taper, shoe.heelY - shoe.cy)
  const shoeArch = Math.PI * shoe.r
  const shoeLength = 2 * shoeLeg + shoeArch
  const shoeAt = (s) => {
    if (s <= shoeLeg) {
      const f = s / shoeLeg
      return [shoe.cx - shoe.r + shoe.taper - shoe.taper * f, shoe.heelY - (shoe.heelY - shoe.cy) * f]
    }
    if (s <= shoeLeg + shoeArch) {
      const phi = (s - shoeLeg) / shoe.r
      return [shoe.cx - shoe.r * Math.cos(phi), shoe.cy - shoe.r * Math.sin(phi)]
    }
    const f = (s - shoeLeg - shoeArch) / shoeLeg
    return [shoe.cx + shoe.r - shoe.taper * f, shoe.cy + (shoe.heelY - shoe.cy) * f]
  }
  const shoeCentre = Array.from({ length: shoe.bands + 1 }, (_, i) => shoeAt(shoeLength * i / shoe.bands))
  // One edge point of the iron, offset from the centre line along its normal: side 1 is the outside of the arch, -1 the inside.
  const shoeEdge = (i, side) => {
    const [ax, ay] = shoeCentre[Math.max(i - 1, 0)]
    const [bx, by] = shoeCentre[Math.min(i + 1, shoe.bands)]
    const run = Math.hypot(bx - ax, by - ay)
    const half = side * shoe.thickness / 2
    const [x, y] = shoeCentre[i]
    return onCanvas([x + (by - ay) / run * half, y - (bx - ax) / run * half])
  }
  const heelL = onCanvas(shoeCentre[0])
  const heelR = onCanvas(shoeCentre[shoe.bands])
  const ironWidth = shoe.thickness * shoeScale

  // The straight line: the visible spectrum from x 300 to 980, with the unlit ultraviolet and infrared past its ends.
  const line = { left: 300, right: 980, top: 400, bottom: 460, reach: 204 }
  const lineX = (i) => line.left + (line.right - line.left) * i / shoe.bands

  const points = (corners) => corners.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(" ")
  const bandOnLine = (i) => points([[lineX(i), line.top], [lineX(i + 1), line.top], [lineX(i + 1), line.bottom], [lineX(i), line.bottom]])
  const bandOnShoe = (i) => points([shoeEdge(i, 1), shoeEdge(i + 1, 1), shoeEdge(i + 1, -1), shoeEdge(i, -1)])
  const bandNm = (i) => 380 + 320 * (i + 0.5) / shoe.bands
  const shoeBands = Array.from({ length: shoe.bands }, (_, i) => i)

//- The purple beat, on three steps. Arrive: the spectrum as a straight line, unlit ultraviolet and infrared past its ends. Fragment 1 (.bend): the unlit ends fade, js/purple-beat.js tweens every band from its data-line shape to its data-shoe shape, and the heels land. Fragment 2: the line of purples draws itself across the gap at the iron's full weight, closing the ring.
mixin purpleBeat()
  svg.purple-beat-drawing(viewBox="0 0 1280 720" role="img")&attributes(attributes)
    title The visible spectrum as a straight line between ultraviolet and infrared, bent into a horseshoe, with the gap between its violet and red ends filled with purple
    defs
      linearGradient#LineOfPurples(gradientUnits="userSpaceOnUse" x1=heelL[0] y1=heelL[1] x2=heelR[0] y2=heelR[1])
        stop(offset="0" stop-color=spectralColour(380))
        stop(offset="1" stop-color=spectralColour(700))
    g.unlit-ends.fragment.fade-out(data-fragment-index="1")
      rect.unlit(x=line.left - line.reach y=line.top width=line.reach height=line.bottom - line.top)
      rect.unlit(x=line.right y=line.top width=line.reach height=line.bottom - line.top)
      g.labels(font-size="34")
        text(x=line.left - line.reach / 2 y=line.top - 20 text-anchor="middle") ultraviolet
        text(x=line.right + line.reach / 2 y=line.top - 20 text-anchor="middle") infrared
        text(x=line.left y=line.bottom + 48 text-anchor="middle") 380 nm
        text(x=line.right y=line.bottom + 48 text-anchor="middle") 700 nm
    g.heels.fragment.fade-in(data-fragment-index="1")
      circle(cx=heelL[0] cy=heelL[1] r=ironWidth / 2 fill=spectralColour(380))
      circle(cx=heelR[0] cy=heelR[1] r=ironWidth / 2 fill=spectralColour(700))
    //- Thin bands, each in its own wavelength's colour, with a hairline in the same colour to hide the seams.
    g.spectrum(stroke-width="1.5" stroke-linejoin="round")
      each i in shoeBands
        polygon(points=bandOnLine(i) data-line=bandOnLine(i) data-shoe=bandOnShoe(i) fill=spectralColour(bandNm(i)) stroke=spectralColour(bandNm(i)))
    g.shoe-labels.labels.bend.fragment.fade-in(data-fragment-index="1" font-size="34")
      text(x=heelL[0] - ironWidth / 2 - 16 y=heelL[1] + 12 text-anchor="end") 380
      text(x=heelR[0] + ironWidth / 2 + 16 y=heelR[1] + 12) 700
    g.bridge.fragment.custom(data-fragment-index="2")
      rect(x=heelL[0] y=heelL[1] - ironWidth / 2 width=heelR[0] - heelL[0] height=ironWidth fill="url(#LineOfPurples)")
      text.name(x=(heelL[0] + heelR[0]) / 2 y=heelL[1] + ironWidth / 2 + 44 font-size="32" text-anchor="middle") the line of purples

//- Webb's infrared, translated. One log wavelength axis from violet's edge at 0.38 micrometres out to 5: the sliver of real colour you see, and the band Webb's NIRCam sees, all of it infrared, unlit, with each filter used for the Pillars image at its real wavelengths in the visible colour the image team gave it. STScI's key: F090W purple, F187N blue, F200W cyan, F335M yellow, F444W orange, F470N red. The same rainbow twice, where it really is and painted across light nobody can see.
-
  const webbX = (um) => +(40 + 920 * (Math.log10(um) - Math.log10(0.38)) / (Math.log10(5) - Math.log10(0.38))).toFixed(1)
  const youSee = [0.38, 0.7]
  const nircam = [0.75, 5]
  // Each filter's band in micrometres and its assigned colour. The narrow filters sit inside wide ones, so they come later and stand taller.
  const webbFilters = [
    { from: 0.795, to: 1.005, colour: "#9b4dff" },
    { from: 1.755, to: 2.226, colour: "#00d0ff" },
    { from: 1.863, to: 1.885, colour: "#2f5bff", narrow: true },
    { from: 3.177, to: 3.537, colour: "#ffe100" },
    { from: 3.88, to: 4.986, colour: "#ff8a00" },
    { from: 4.683, to: 4.733, colour: "#ff2a1a", narrow: true },
  ]
  const filterBox = (f) => {
    if (!f.narrow) return { x: webbX(f.from), width: webbX(f.to) - webbX(f.from), y: 80, height: 160 }
    const centre = (webbX(f.from) + webbX(f.to)) / 2
    return { x: centre - 7, width: 14, y: 62, height: 196 }
  }

mixin webbTranslation()
  svg.translation(viewBox="0 0 1000 320" role="img")&attributes(attributes)
    title The sliver of visible light humans see, next to the much wider band of infrared Webb sees, painted with visible colours in wavelength order: purple, blue, cyan, yellow, orange and red
    defs
      linearGradient#YouSee(x1="0" x2="1" y1="0" y2="0")
        each nm in lineStops
          stop(offset=(nm - 380) / 320 stop-color=spectralColour(nm))
    line.axis(x1="40" y1="240" x2="960" y2="240")
    rect(x=webbX(youSee[0]) y="80" width=webbX(youSee[1]) - webbX(youSee[0]) height="160" fill="url(#YouSee)")
    rect.unlit(x=webbX(nircam[0]) y="80" width=webbX(nircam[1]) - webbX(nircam[0]) height="160")
    each f in webbFilters
      - const box = filterBox(f)
      rect(x=box.x y=box.y width=box.width height=box.height fill=f.colour)
    g.labels(font-size="34")
      text(x=(webbX(youSee[0]) + webbX(youSee[1])) / 2 y="44" text-anchor="middle") you
      text(x=(webbX(nircam[0]) + webbX(nircam[1])) / 2 y="44" text-anchor="middle") Webb
      text(x=(webbX(youSee[0]) + webbX(youSee[1])) / 2 y="300" text-anchor="middle") visible
      text(x=(webbX(nircam[0]) + webbX(nircam[1])) / 2 y="300" text-anchor="middle") infrared
